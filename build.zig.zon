.{
    .name = .slog,
    .version = "0.1.0",
    .fingerprint = 0x28b061b90f84a949,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#b04c00924114d85da442ecedf727a8fa0a47ab69",
            .hash = "json-0.1.0-tOue4cGpCwC1XAWh-24CNMEkZLXcTSy2WCV1rxiAiAd7",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#fa7ce790ca2b59d1170644ce9e9b190a6aad8d1b",
            .hash = "thread_pool-0.2.1-11B1BobIdgD7WQ2I5rgfsqZxogEhnhOssfgDH_N_0Vjd",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. slog is itself a transitive otel dep
        // (otel routes std.log through slog when
        // `-Dotel_use_devnw_slog=true`); the lazy + comptime gate
        // breaks the cycle. Pin tracked in the otel rollout plan;
        // bump SHA + hash together via `zig fetch --save`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#2665f64d4fb85f8d7beb6b21f2218317ea2fc05e",
            .hash = "otel-0.1.0-B0v3lrgNNADQwluWDPhv5kY_7L_C1vptqunNkx_Ipzy1",
            .lazy = true,
        },
    },
}
