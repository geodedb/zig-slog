.{
    .name = .slog,
    .version = "0.1.0",
    .fingerprint = 0x28b061b90f84a949,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#3fe6b5e54d9178e7934678b60860d68166886c62",
            .hash = "json-0.1.0-tOue4cGpCwAqJ9-IF29UgCs0gRtE__k5aoFSMYYHLwNi",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#7fb7501563b447bec3ef253be14d9f8d8f0443ef",
            .hash = "thread_pool-0.2.1-11B1BoLIdgChPpTBcutApyan1-i28GNwa8xB1ojizPL0",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. slog is itself a transitive otel dep
        // (otel routes std.log through slog when
        // `-Dotel_use_devnw_slog=true`); the lazy + comptime gate
        // breaks the cycle. Pin tracked in the otel rollout plan;
        // bump SHA + hash together via `zig fetch --save`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#ee492166dfefc7914229979c933411e6da9e504e",
            .hash = "otel-0.1.0-B0v3lr2UMwA5qFJCa20OT-1huDPLm1sTIFD22PQBADDD",
            .lazy = true,
        },
    },
}
