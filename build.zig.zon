.{
    .name = .slog,
    .version = "0.1.0",
    .fingerprint = 0x28b061b90f84a949,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#30b3983dfaab83ebc827205567c32542e111616b",
            .hash = "json-0.1.0-tOue4cGpCwCGYhHHbM0EF6LxFTxPS2s9rcbKRD-o5xW7",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#ee8440f69012cad49fa1d5f22fe18c68f944d9ab",
            .hash = "thread_pool-0.2.0-11B1Bj_edQCU0Y_-zzOoXuytAgqEkDkfuw2nB-YxUmEL",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. slog is itself a transitive otel dep
        // (otel routes std.log through slog when
        // `-Dotel_use_devnw_slog=true`); the lazy + comptime gate
        // breaks the cycle. Pin tracked in the otel rollout plan;
        // bump SHA + hash together via `zig fetch --save`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel#20078af231c069d88eaeb79dcf950b94366be624",
            .hash = "otel-0.1.0-B0v3lsl9MwCHrG8GDrxdFebugqjybfr4KAiplOJKCRG7",
            .lazy = true,
        },
    },
}
