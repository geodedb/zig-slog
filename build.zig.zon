.{
    .name = .slog,
    .version = "0.1.0",
    .fingerprint = 0x28b061b90f84a949,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#0adaa347ea4c1d70b100676019de3b375b63c357",
            .hash = "json-0.1.0-tOue4cGpCwB5_tkAlBqcI8Vsp1SytlrD83ef93NCegKE",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#f779ab8150dba03f0bde85dd6401c137de04c0e3",
            .hash = "thread_pool-0.2.1-11B1BobIdgATaQdu3KWiqXyCSSkn8-ic9tJS00_Iwbt-",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. slog is itself a transitive otel dep
        // (otel routes std.log through slog when
        // `-Dotel_use_devnw_slog=true`); the lazy + comptime gate
        // breaks the cycle. Pin tracked in the otel rollout plan;
        // bump SHA + hash together via `zig fetch --save`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#f17cf51306f87dd200c482709a653247c7b69772",
            .hash = "otel-0.1.0-B0v3lpwNNACMQqP5_axFbUW-46-__Pl8c3qh3RYXQ8gh",
            .lazy = true,
        },
    },
}
