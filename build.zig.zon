.{
    .name = .slog,
    .version = "0.1.0",
    .fingerprint = 0x28b061b90f84a949,
    .minimum_zig_version = "0.16.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "README.md",
        "LICENSE",
    },
    .dependencies = .{
        .json = .{
            .url = "git+https://gitlab.com/devnw/zig/json.git#3d4126a200698bf1f0d69646e62d31b898af8178",
            .hash = "json-0.1.0-tOue4cGpCwBES01Fy4ZZtfrVxZB787akpS7DTgbCcSaB",
        },
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git#2da0f3055ae109e8c0a34b02db6d04493fd6948e",
            .hash = "thread_pool-0.2.1-11B1BobIdgCNh_BzZ_4Ed4oSbXu1msJz_XCW9FJZtU4S",
        },
        // otel observability seam. Lazy, so a default-flag build
        // (`-Dwith_otel=false`) never resolves or fetches the package.
        // Reached by `b.lazyDependency("otel", ...)` in build.zig only
        // when `-Dwith_otel=true`. slog is itself a transitive otel dep
        // (otel routes std.log through slog when
        // `-Dotel_use_devnw_slog=true`); the lazy + comptime gate
        // breaks the cycle. Pin tracked in the otel rollout plan;
        // bump SHA + hash together via `zig fetch --save`.
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#a1647d2f26f73ec2042b12ab60c1ee3effb7d411",
            .hash = "otel-0.1.0-B0v3lrgNNAC_Asch0mgFZ-vhA2cXGmBss4K1xNjmTnzA",
            .lazy = true,
        },
    },
}
